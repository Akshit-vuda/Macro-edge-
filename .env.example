# MacroEdge environment — copy to .env and fill in. NEVER commit .env.
# ── Core ──
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/macroedge.db

# ── Claude (brain) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_DAILY_USD_CAP=5.00

# ── Alpaca (PAPER trading + market data) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# ── moomoo / Futu (LIVE execution via OpenD gateway) ──
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_TRADE_PWD=            # trade-unlock password (keep secret)
MOOMOO_TRADE_ENV=SIMULATE   # SIMULATE | REAL  (REAL only after live-gate)
MOOMOO_ACCOUNT_ID=

# ── News / data ──
NEWSAPI_KEY=
POLYGON_API_KEY=
USE_POLYGON=false

# ── Slack (ChatOps) ──
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=             # Socket Mode app-level token (xapp-...)
SLACK_APPROVAL_CHANNEL=

# ── MLflow (learning tracking) ──
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
